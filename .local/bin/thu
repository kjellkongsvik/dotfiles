#!/usr/bin/env bash

pick=$(zellij ac dump-screen | thumbs -u -r)
# OSC52
printf "\033]52;c;$(printf $pick | base64)\a"

case "$1" in
  hx*)
    if [[ -n "$pick" ]]; then
      pick=$(echo "$pick" | sed 's/(/:/g; s/,/:/g; s/)//g; s/ //g')
      zellij ac move-focus left
      zellij action send-keys "Esc"
      zellij action write-chars ":o $pick"
      zellij action send-keys "Enter"
    fi
    ;;
esac
